# Copy to backend/.env and adjust. Never commit real keys.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchos
# STORAGE_DIR=../data/storage
MAX_UPLOAD_MB=50

# ---- LLM: none | anthropic | openai (any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=sk-ant-...
# LLM_EFFORT=medium           # Anthropic output_config.effort: low|medium|high|xhigh|max
# LLM_FALLBACKS=default       # Anthropic server-side refusal fallback; "off" to disable
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model
# LLM_API_KEY=...

# ---- Embeddings: hash (offline lexical, default) | openai (OpenAI-compatible /embeddings)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=...
# Changing the embedding provider requires re-processing documents (vectors are tagged by model).

# ---- Retrieval thresholds
RETRIEVAL_MIN_TERM_COVERAGE=0.5
RETRIEVAL_MIN_VECTOR_SIM=0.55
RETRIEVAL_COMPARE_MIN_TERM_COVERAGE=0.3
RETRIEVAL_TOP_K=8
